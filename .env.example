# Discord
# The bot's role needs the "Manage Channels" permission in the server —
# required for the data-import feature to create channels for restored
# collages that have no live Discord channel to match against.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/punk_records

# API
PORT=3001
API_URL=http://localhost:3001

# OMDB API — free key from https://www.omdbapi.com/apikey.aspx (required for IMDb card posters)
OMDB_API_KEY=

# Reddit API — free "script" app at https://www.reddit.com/prefs/apps (required for Reddit card previews)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
